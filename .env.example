# Copy to .env and edit. Both Docker Compose and `python -m server` read it automatically.

# ---------- Security (set both before exposing this to a network) ----------
# Password for the web page.
APP_PASSWORD=change-me
# Secret for the ring API (POST /api/ring). Generate one: openssl rand -hex 24
API_TOKEN=
# Keeps people logged in across restarts. Generate one: openssl rand -hex 32
SESSION_SECRET=

# ---------- The AI brain: any OpenAI-compatible chat completions endpoint ----------
# Ollama (free, local). On Docker Desktop use http://host.docker.internal:11434/...
LLM_URL=http://127.0.0.1:11434/v1/chat/completions
LLM_MODEL=llama3.2
LLM_API_KEY=

# OpenClaw Gateway (first set gateway.http.endpoints.chatCompletions.enabled=true in OpenClaw).
# The model is openclaw:<agentId>; the key is your gateway.auth.token.
# LLM_URL=http://127.0.0.1:18789/v1/chat/completions
# LLM_MODEL=openclaw:main
# LLM_API_KEY=your-gateway-token

# OpenAI / OpenRouter / anything else compatible:
# LLM_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# Optional: replace the default personality.
# SYSTEM_PROMPT=You are ...

# ---------- Speech-to-text ----------
# faster-whisper runs locally (free). Models: tiny.en, base.en, small.en, medium.en, large-v3
STT_BACKEND=faster-whisper
WHISPER_MODEL=base.en
# Or a hosted, OpenAI-compatible /v1/audio/transcriptions endpoint:
# STT_BACKEND=openai
# STT_URL=https://api.openai.com/v1/audio/transcriptions
# STT_MODEL=whisper-1
# STT_API_KEY=sk-...

# ---------- Text-to-speech ----------
# Piper runs locally (free). Voice names: https://huggingface.co/rhasspy/piper-voices
TTS_BACKEND=piper
PIPER_VOICE=en_US-lessac-medium
# Or a hosted, OpenAI-compatible /v1/audio/speech endpoint:
# TTS_BACKEND=openai
# TTS_URL=https://api.openai.com/v1/audio/speech
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy
# TTS_API_KEY=sk-...

# ---------- Calls ----------
AI_NAME=Assistant
GREETING="Hey, it's your assistant. What's up?"
# Seconds the AI lets your call ring before it picks up.
AI_ANSWER_DELAY=4
# Seconds the AI's call rings you before it counts as missed.
RING_TIMEOUT=30

# ---------- Turn-taking (tune if it cuts you off or ignores you) ----------
# Speech detection: "silero" (a small speech model, ignores noise) or "energy" (plain loudness).
VAD_BACKEND=silero
# How sure the model must be that it's speech, 0-1. Raise it if noise still triggers replies.
VAD_THRESHOLD=0.5
# Minimum mic level needed to interrupt the AI. Raise it if the AI's own voice (echo) cuts it off,
# lower it if you can't interrupt. Run with LOG_LEVEL=DEBUG to see your levels.
VAD_MIN_RMS=150
# Pause length (ms) that ends your turn.
SILENCE_MS=700
# How long (ms) you must talk over the AI to interrupt it.
BARGE_IN_MS=300

# ---------- Networking ----------
PORT=8080
# STUN/TURN servers, comma-separated. Add a TURN server if calls connect but have no audio.
ICE_SERVERS=stun:stun.l.google.com:19302
# TURN_USERNAME=
# TURN_PASSWORD=
LOG_LEVEL=INFO
